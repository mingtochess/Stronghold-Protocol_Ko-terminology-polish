{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stronghold-ko",
  "main": "worker.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "placement": {
    "region": "aws:ap-northeast-2"
  },
  "assets": {
    "directory": "../../public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "containers": [
    {
      "class_name": "GameServer",
      "image": "../../Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME",
        "class_name": "GameServer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameServer"
      ]
    }
  ],
  "triggers": {
    "crons": []
  },
  "observability": {
    "enabled": true
  }
}
