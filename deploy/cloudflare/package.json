{
  "name": "stronghold-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "resources": "node ../../tools/build-browser-resources.mjs",
    "precheck": "npm run resources",
    "dev": "wrangler dev --config wrangler.jsonc",
    "check": "tsc --noEmit && wrangler deploy --dry-run --outdir /tmp/stronghold-worker-build",
    "deploy": "wrangler deploy",
    "predeploy": "npm run resources",
    "test": "node --test worker.test.mjs"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "wrangler": "4.147.0",
    "typescript": "^5.9.3",
    "@cloudflare/workers-types": "5.20261003.1"
  }
}
